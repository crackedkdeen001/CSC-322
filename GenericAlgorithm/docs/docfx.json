{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "GenericAlgorithm.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
        { "files": [ "api/**.yml", "api/index.md" ] },                                                    
        { "files": [ "*.md", "toc.yml" ] }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "GenericAlgorithm",
      "_appTitle": "Insertion Sort Generic Algorithm",
      "_enableSearch": true,
    }
  }
}